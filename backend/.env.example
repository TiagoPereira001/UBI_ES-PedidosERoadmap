# Copiar para .env e mudar os valores. O .env nunca vai para o Git.
DJANGO_SECRET_KEY=muda-isto
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Com POSTGRES_HOST definido usa PostgreSQL (é o que o docker-compose.yml faz); sem ele, SQLite.
# POSTGRES_HOST=localhost
# POSTGRES_DB=pedidos
# POSTGRES_USER=pedidos
# POSTGRES_PASSWORD=muda-isto
# Serviços de IA (opcional, ver wiki/04-arquitetura/ia.md). Sem nenhum, usa-se a regra local.
# Modelo local no LM Studio (não precisa de chave). Com Docker: http://host.docker.internal:1234
# LMSTUDIO_URL=http://localhost:1234
# LMSTUDIO_MODELO=google/gemma-4-e4b
# Só se a autenticação estiver ligada no LM Studio:
# LMSTUDIO_API_KEY=o-teu-token
# LMSTUDIO_TEMPO_LIMITE=60
# Gemini (Google), tem um plano gratuito: chave em https://aistudio.google.com/apikey
# GEMINI_API_KEY=a-tua-chave
# GEMINI_MODELO=gemini-3.5-flash-lite
# Claude (Anthropic), pago por utilização: chave em https://console.anthropic.com
# ANTHROPIC_API_KEY=a-tua-chave
# IA_MODELO=claude-opus-5-5
# Com vários usa-se o local, depois o Gemini; para obrigar a um deles: lmstudio, gemini ou claude.
# IA_FORNECEDOR=lmstudio
# IA_TEMPO_LIMITE=20
# CAPACIDADE_SPRINT=15
